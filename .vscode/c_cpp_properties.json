{
    "configurations": [
        {
            "name": "Mac",
            "includePath": [
                "${workspaceFolder}/cpp/include",
                "${workspaceFolder}/cpp/src"
            ],
            "defines": [],
            "compilerPath": "/usr/bin/clang++",
